    "url": "git+https://github.com/opaolini/pi-jev-openrouter.git"
  },
  "scripts": {
    "test": "bun test && node --test test/*.test.mjs"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "@openrouter/sdk": "1.3.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
